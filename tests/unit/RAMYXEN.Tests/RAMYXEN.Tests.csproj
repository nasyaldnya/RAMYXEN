  <ItemGroup>
    <ProjectReference Include="..\..\..\src\RAMYXEN.Core\RAMYXEN.Core.csproj" />
    <ProjectReference Include="..\..\..\src\RAMYXEN.Diagnostics\RAMYXEN.Diagnostics.csproj" />
    <ProjectReference Include="..\..\..\src\RAMYXEN.Localization\RAMYXEN.Localization.csproj" />
