    <ProjectReference Include="..\..\..\src\RAMYXEN.Memory.Engine\RAMYXEN.Memory.Engine.csproj" />
    <ProjectReference Include="..\..\..\src\RAMYXEN.ETW\RAMYXEN.ETW.csproj" />
    <ProjectReference Include="..\..\..\src\RAMYXEN.Profiler\RAMYXEN.Profiler.csproj" />
    <ProjectReference Include="..\..\..\src\RAMYXEN.Forensics\RAMYXEN.Forensics.csproj" />
    <ProjectReference Include="..\..\..\src\RAMYXEN.Reporting\RAMYXEN.Reporting.csproj" />
    <ProjectReference Include="..\..\..\src\RAMYXEN.Application\RAMYXEN.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\src\RAMYXEN.Native\bin\Release\RAMYXEN.Native.dll" Link="RAMYXEN.Native.dll" CopyToOutputDirectory="PreserveNewest" />
