# ==============================================================================
# RAMYXEN .editorconfig — Cross-Editor Formatting & UTF-8 / RTL Standards
# ==============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,xaml,cpp,hpp,h,rs}]
indent_size = 4

[*.{ps1,cmd,bat,sln,csproj,vcxproj}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[localization/locales/*.json]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
