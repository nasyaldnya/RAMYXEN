# ==============================================================================
# RAMYXEN .gitattributes — Consistent Line Endings & UTF-8 / Arabic Unicode Safety
# ==============================================================================

# Auto-detect text files and normalize to LF in the repository
* text=auto eol=lf

# Localization, JSON, Markdown, Web & Source files (UTF-8, LF)
*.json text working-tree-encoding=UTF-8 eol=lf
*.md text working-tree-encoding=UTF-8 eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.cs text eol=lf
*.xaml text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.rs text eol=lf

# Windows-native scripts and Visual Studio project files (CRLF)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.vcxproj text eol=crlf

# Binary assets (never alter line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
